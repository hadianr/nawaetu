{
  "name": "nawaetu",
  "version": "1.15.6",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "browserslist": [
    "chrome >= 100",
    "firefox >= 100",
    "edge >= 100",
    "safari >= 16",
    "ios >= 16"
  ],
  "description": "Gamified Islamic habit tracker app featuring Al-Quran, Prayer Times, Qibla Compass, and AI Spiritual Assistant. Built with Next.js and TypeScript.",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "node .next/standalone/server.js",
    "start:next": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "analyze": "ANALYZE=true next build --webpack && node scripts/analyze-bundle.mjs",
    "test": "VITE_CJS_IGNORE_WARNING=1 vitest",
    "test:run": "VITE_CJS_IGNORE_WARNING=1 vitest run",
    "test:coverage": "VITE_CJS_IGNORE_WARNING=1 vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "release": "bash scripts/release.sh",
    "db:migrate": "drizzle-kit migrate",
    "db:verify:progression": "node scripts/verify-progression-migration.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build:extension": "cd extension && zip -r ../nawaetu-extension.zip *"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-avatar": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-progress": "^1.1.13",
    "@radix-ui/react-scroll-area": "^1.2.15",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.4",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@sentry/nextjs": "^10.75.1",
    "@types/sanitize-html": "^2.16.1",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^13.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.31",
    "nextjs-toploader": "^3.9.17",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    },
    "@auth/core": {
      "cookie": ">=0.7.0"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "^2.0.1"
    },
    "sharp": "^0.35.4",
    "gaxios": "^7.2.0",
    "postcss": "^8.5.20",
    "retry-request": "^8.0.3",
    "serialize-javascript": "^7.0.7",
    "teeny-request": "^10.1.3",
    "workbox-build": "^7.4.1",
    "workbox-webpack-plugin": "^7.4.1"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "@sentry/cli@2.58.6": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "protobufjs": false,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "jsdom": "30.1.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}
